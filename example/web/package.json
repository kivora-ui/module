{
  "name": "@kivora/example-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @kivora/nextjs... build",
    "dev": "next dev --hostname 127.0.0.1",
