{
  "name": "kivora",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for Kivora cross-platform UI packages.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @kivora/example-web dev",
    "build:web": "pnpm --filter @kivora/example-web build",
    "test:web": "pnpm build:web && pnpm --filter @kivora/example-web test:e2e",
    "build": "pnpm -r build",
    "publish:native": "node scripts/release.mjs publish native",
    "publish:nextjs": "node scripts/release.mjs publish nextjs",
    "publish:theme": "node scripts/release.mjs publish theme",
    "publish:init": "node scripts/release.mjs publish init",
    "storybook": "pnpm --filter @kivora/storybook storybook",
    "build:storybook": "pnpm --filter @kivora/storybook build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:datepicker:e2e": "playwright test tests/date-picker.playwright.spec.ts --browser=chromium --reporter=line",
    "dev:app": "pnpm --filter @kivora/example-app start",
    "android:app": "pnpm --filter @kivora/example-app android",
    "build:app": "pnpm --filter @kivora/native... build && pnpm --filter @kivora/example-app build",
    "test:app": "pnpm --filter @kivora/example-app test",
    "publish:codes": "node scripts/release.mjs publish codes",
    "dev:uploads": "node scripts/upload-server.mjs",
    "publish:upload": "node scripts/release.mjs publish upload",
    "docs:components": "node scripts/generate-component-docs.mjs",
    "release:prepare": "pnpm --filter \"./packages/**\" build && node --test scripts/release.test.mjs && node scripts/release.mjs pack",
    "test:packaging": "node --test scripts/release.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.5",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "cross-spawn": "^7.0.6",
    "semver": "^7.7.2"
  },
  "pnpm": {
    "patchedDependencies": {
      "react-native-css-interop@0.2.6": "patches/react-native-css-interop@0.2.6.patch"
    }
  }
}
