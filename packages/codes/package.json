{
  "name": "@kivora/codes",
  "version": "0.1.0",
  "description": "Local SVG generation for QR codes and barcodes, shared by Kivora web and native components.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-license.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "node ../../scripts/release.mjs guard"
  },
  "dependencies": {
    "@bwip-js/generic": "^4.11.4"
  },
  "devDependencies": {
    "@zxing/library": "^0.21.3",
    "sharp": "^0.34.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
