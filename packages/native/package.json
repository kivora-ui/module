{
  "name": "@kivora/native",
  "version": "0.3.0",
  "description": "Kivora UI components for React Native.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "android/build.gradle",
    "android/src",
    "ios",
    "KivoraNative.podspec",
    "react-native.config.cjs",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!android/src/test"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "node ../../scripts/release.mjs guard"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@kivora/codes": "0.1.0",
    "@kivora/theme": "0.1.0",
    "@kivora/upload": "0.1.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react-native": "^1.40.0",
    "prismjs": "^1.30.0",
    "react-native-reanimated-carousel": "4.0.3"
  },
  "peerDependencies": {
    "@kesha-antonov/react-native-background-downloader": "^4.6.2",
    "@notifee/react-native": "^9.1.8",
    "nativewind": "^4.2.6",
    "react": ">=19.2.3 <20",
    "react-native": ">=0.85.3 <0.86 || >=0.87.1 <0.88",
    "react-native-gesture-handler": ">=2.32 <3",
    "react-native-keyboard-controller": ">=1.22.4 <2",
    "react-native-fs": "^2.20.0",
    "react-native-orientation-locker": "1.7.0",
    "react-native-reanimated": ">=4.3 <4.4 || >=4.6 <4.7",
    "react-native-safe-area-context": ">=5",
    "react-native-svg": ">=15",
    "react-native-video": "6.19.2",
    "react-native-google-cast": "4.9.1",
    "react-native-worklets": ">=0.8.3 <0.9 || >=0.12.2 <0.13"
  },
  "devDependencies": {
    "@kesha-antonov/react-native-background-downloader": "^4.6.2",
    "@notifee/react-native": "^9.1.8",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "nativewind": "4.2.6",
    "react-native-fs": "^2.20.0",
    "react-native-keyboard-controller": "1.22.4",
    "react-native-orientation-locker": "1.7.0",
    "react-native-reanimated": "4.6.0",
    "react-native-video": "6.19.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "react-native-google-cast": "4.9.1",
    "react-native-worklets": "0.12.2",
    "react-native": "0.87.1",
    "react": "19.2.3",
    "react-native-gesture-handler": "2.32.0",
    "tailwindcss": "3.4.19",
    "@react-native/metro-config": "0.87.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "react-native-google-cast": {
      "optional": true
    }
  }
}
