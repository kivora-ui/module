{
  "name": "@kivora/nextjs",
  "version": "0.2.0",
  "description": "Kivora UI components for Next.js.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./dist/tailwind.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-styles.mjs && node scripts/verify-styles.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:styles": "node scripts/build-styles.mjs && node scripts/verify-styles.mjs"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.1",
    "@kivora/codes": "workspace:*",
    "@kivora/theme": "workspace:*",
    "@kivora/upload": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-direction": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-hover-card": "^1.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.0",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.13.0",
    "@uppy/audio": "^4.0.0",
    "@uppy/core": "^6.0.0",
    "@uppy/dashboard": "^6.0.0",
    "@uppy/google-drive-picker": "^2.0.0",
    "@uppy/google-photos-picker": "^2.0.0",
    "@uppy/image-editor": "^5.0.0",
    "@uppy/image-generator": "^2.0.0",
    "@uppy/locales": "^5.2.0",
    "@uppy/remote-sources": "^4.0.0",
    "@uppy/screen-capture": "^6.0.0",
    "@uppy/tus": "^6.0.0",
    "@uppy/url": "^6.0.0",
    "@uppy/webcam": "^6.0.0",
    "@uppy/webdav": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.0",
    "date-fns": "^4.1.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.40.0",
    "motion": "^13.2.0",
    "react-imask": "^7.6.1",
    "react-resizable-panels": "^3.0.0",
    "react-select": "^5.8.0",
    "react-slick": "^0.31.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.1.0",
    "shaka-player": "^5.2.9",
    "slick-carousel": "^1.8.1",
    "sonner": "^2.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "@types/react-slick": "^0.23.13",
    "@types/react-syntax-highlighter": "^15.5.13",
    "jsdom": "^25.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "@tailwindcss/postcss": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "postcss": "^8.5.26"
  },
  "publishConfig": {
    "access": "public"
  }
}
